{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clickchain.ai/contracts/share-snapshot-v1.schema.json",
  "title": "Shared roadmap snapshot request body (v1)",
  "description": "Mirrors lib/share/snapshot-schema.ts. Rules JSON Schema cannot express are enforced only by the validator: every node parent id names a node in the list (or is null); the parent links are acyclic; node ids are unique; every forecast id names a node; doneOn and the date part of each timestamp are real calendar dates (for example 2026-02-30 is rejected by the validator); p95Hours has at most one decimal. Length limits count UTF-16 code units (compile with ajv option unicode:false).",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
    "generatedAt": { "$ref": "#/definitions/utcTimestamp" },
    "sourceCommittedAt": { "$ref": "#/definitions/utcTimestamp" },
    "goal": { "type": "string", "maxLength": 300 },
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/definitions/node" }
    },
    "forecast": {
      "type": "array",
      "items": { "$ref": "#/definitions/forecastItem" }
    }
  },
  "required": ["schemaVersion", "productId", "sourceRevision", "generatedAt", "sourceCommittedAt", "goal", "nodes"],
  "additionalProperties": false,
  "definitions": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?Z$"
    },
    "nodeId": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "node": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "parent": { "anyOf": [{ "$ref": "#/definitions/nodeId" }, { "type": "null" }] },
        "problem": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,300}$" },
        "status": { "enum": ["next", "now", "blocked", "paused", "merged", "done", "parked"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "doneOn": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "required": ["id", "parent", "problem", "status", "order", "doneOn"],
      "additionalProperties": false
    },
    "forecastItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "p95Hours": { "type": "number", "minimum": 0, "maximum": 10000 }
      },
      "required": ["id", "p95Hours"],
      "additionalProperties": false
    }
  }
}
